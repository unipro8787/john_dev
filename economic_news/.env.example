# 카카오톡 "나에게 보내기" 알림에 필요한 값. kakao_get_token.py 실행해서 발급받으세요.
KAKAO_REST_API_KEY=
KAKAO_REFRESH_TOKEN=
# Client Secret이 "사용함"으로 설정된 앱이면 필수 (앱 설정 > 앱 키 > REST API 키 상세에서 확인)
KAKAO_CLIENT_SECRET=

# 뉴스 헤드라인 요약에 쓰는 Claude API 키 (console.anthropic.com 에서 발급)
ANTHROPIC_API_KEY=
# 생략 시 기본값(claude-sonnet-5) 사용. 비용을 더 줄이려면 claude-haiku-4-5-20251001 등으로 변경 가능
ANTHROPIC_MODEL=
