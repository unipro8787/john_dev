# 화성특례시 통합예약시스템 로그인 정보 (tennis_checker/.env와 동일한 계정 사용 가능)
HSCITY_ID=your_id_here
HSCITY_PW=your_password_here

# 주민등록번호 - 앞자리(6자리) / 뒷자리(7자리). 본인이 직접 입력하세요.
HSCITY_RESIDENT1=000000
HSCITY_RESIDENT2=0000000

# 환불 계좌 정보
HSCITY_REFUND_BANK=081
HSCITY_REFUND_ACCOUNT=000000000000
HSCITY_DEPOSITOR=안유현

# 예약 대상 - 세미콜론(;)으로 여러 날짜/시간을 나열하면 각각 순서대로 시도해서
# 가능한 만큼(여러 건이라도) 전부 예약합니다. TARGET_SLOTS이 없으면 TARGET_DATE/TARGET_TIME_LABEL 한 건만 씁니다.
TARGET_SLOTS=2026-07-30 06:00~08:00; 2026-07-31 06:00~08:00
TARGET_DATE=2026-07-31
TARGET_TIME_LABEL=06:00~08:00
TARGET_COURTS=1,2,5,6,7,8

# 신청서 내용
HSCITY_EVENT_CONTENT=테니스 경기
HSCITY_PERSON_NUM=4

# 카카오톡 "나에게 보내기" 알림 (선택). 없으면 알림 없이 터미널 입력만 사용합니다.
# 발급 방법: kakao_get_token.py 실행 참고
KAKAO_ACCESS_TOKEN=

# 폰에서도 보안문자를 직접 입력할 수 있게 하는 ngrok 터널용 토큰 (선택).
# 없으면 PC 터미널 입력만 가능합니다. 발급: https://dashboard.ngrok.com/get-started/your-authtoken
# (무료 가입 필요, 대시보드에서 토큰 복사)
NGROK_AUTHTOKEN=
# (선택) ngrok 대시보드(https://dashboard.ngrok.com/domains)에서 예약한 무료 고정 도메인.
# 설정해두면 remote_launcher.py를 재시작해도 링크가 안 바뀌어서, 폰 홈 화면 아이콘이 계속 같은 주소로 열린다.
NGROK_DOMAIN=
REMOTE_CAPTCHA_PORT=5001
